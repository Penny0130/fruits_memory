    <!-- 遊戲邏輯 Script -->
    <script>
        // 基礎 4 種水果資料 (完全不含葡萄與鳳梨)
        const BASE_ITEMS = [
            { id: 'apple', name: '蘋果', emoji: '🍎', action: '拍手', actionEmoji: '👏', color: 'text-rose-600' },
            { id: 'orange', name: '橘子', emoji: '🍊', action: '拍腳', actionEmoji: '🦶', color: 'text-orange-600' },
            { id: 'watermelon', name: '西瓜', emoji: '🍉', action: '拍頭', actionEmoji: '👤', color: 'text-emerald-600' },
            { id: 'banana', name: '香蕉', emoji: '🍌', action: '拍肚子', actionEmoji: '🫄', color: 'text-yellow-600' }
        ];

        // 擴充 2 種水果資料
        const EXTRA_ITEMS = [
            { id: 'grape', name: '葡萄', emoji: '🍇', action: '雙手拍肩', actionEmoji: '🙋', color: 'text-purple-600' },
            { id: 'pineapple', name: '鳳梨', emoji: '🍍', action: '踏步', actionEmoji: '🦵', color: 'text-amber-600' }
        ];

        // 全部 6 種水果大集合
        const ALL_SIX_ITEMS = [...BASE_ITEMS, ...EXTRA_ITEMS];

        // 遊戲狀態
        let currentPhaseMode = 'single_4_fruits'; // 'single_4_fruits', 'sequence_4_fruits', 'reverse_action', 'six_fruits_gradual'
        let questionCount = 0;
        let soundEnabled = true;

        // Web Audio API 音效
        let audioCtx = null;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        }

        function playTone(freq, type = 'sine', duration = 0.15) {
            if (!soundEnabled) return;
            try {
                initAudio();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch (e) {}
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            document.getElementById('soundIcon').className = soundEnabled ? 'fas fa-volume-up' : 'fas fa-volume-mute';
        }

        // 切換全螢幕
        function toggleFullscreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().then(() => {
                    updateFullscreenBtn(true);
                }).catch(err => {
                    alert(`全螢幕無法啟動: ${err.message}`);
                });
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen().then(() => updateFullscreenBtn(false));
                }
            }
        }

        function updateFullscreenBtn(isFullscreen) {
            const btn = document.getElementById('fullscreenBtn');
            const icon = document.getElementById('fullscreenIcon');
            if (isFullscreen) {
                icon.className = 'fas fa-compress';
                btn.querySelector('span').textContent = '退出全螢幕';
                btn.classList.replace('bg-rose-500', 'bg-slate-600');
            } else {
                icon.className = 'fas fa-expand';
                btn.querySelector('span').textContent = '全螢幕顯示';
                btn.classList.replace('bg-slate-600', 'bg-rose-500');
            }
        }

        document.addEventListener('fullscreenchange', () => {
            updateFullscreenBtn(!!document.fullscreenElement);
        });

        // 顯示規則說明頁
        function showInstruction(page = 1) {
            document.getElementById('gamePlayScreen').classList.add('hidden');
            if (page === 1) {
                document.getElementById('stepInstruction1').classList.remove('hidden');
                document.getElementById('stepInstruction2').classList.add('hidden');
            } else {
                document.getElementById('stepInstruction1').classList.add('hidden');
                document.getElementById('stepInstruction2').classList.remove('hidden');
            }
            playTone(440);
        }

        // 開始階段模式
        function startPhase(mode) {
            initAudio();
            currentPhaseMode = mode;
            questionCount = 0;

            document.getElementById('stepInstruction1').classList.add('hidden');
            document.getElementById('stepInstruction2').classList.add('hidden');
            document.getElementById('gamePlayScreen').classList.remove('hidden');

            const phaseBadge = document.getElementById('phaseBadge');
            const levelTag = document.getElementById('levelTag');

            levelTag.classList.add('hidden');

            if (mode === 'single_4_fruits') {
                phaseBadge.textContent = '【基礎篇】單一水果反應 (僅4種水果)';
                phaseBadge.className = 'bg-amber-300 border-4 border-amber-600 text-amber-950 font-black text-xl md:text-2xl px-8 py-2 rounded-full shadow-md text-center';
            } else if (mode === 'sequence_4_fruits') {
                phaseBadge.textContent = '【基礎篇】1~4個水果序列 (僅4種水果)';
                phaseBadge.className = 'bg-purple-300 border-4 border-purple-600 text-purple-950 font-black text-xl md:text-2xl px-8 py-2 rounded-full shadow-md text-center';
                levelTag.classList.remove('hidden');
            } else if (mode === 'reverse_action') {
                phaseBadge.textContent = '【反向搶答】看動作，搶答水果名稱！';
                phaseBadge.className = 'bg-indigo-300 border-4 border-indigo-600 text-indigo-950 font-black text-xl md:text-2xl px-8 py-2 rounded-full shadow-md text-center';
            } else if (mode === 'six_fruits_gradual') {
                phaseBadge.textContent = '【高級進階】6種水果漸進挑戰（包含葡萄與鳳梨）';
                phaseBadge.className = 'bg-emerald-300 border-4 border-emerald-600 text-emerald-950 font-black text-xl md:text-2xl px-8 py-2 rounded-full shadow-md text-center';
                levelTag.classList.remove('hidden');
            }

            nextQuestion();
        }

        // 出題邏輯
        function nextQuestion() {
            questionCount++;
            document.getElementById('questionCounter').textContent = `第 ${questionCount} 題`;

            const fruitDisplayArea = document.getElementById('fruitDisplayArea');
            const mainTitle = document.getElementById('mainTitle');
            const subInstruction = document.getElementById('subInstruction');
            const displayContainer = document.getElementById('displayTargetContainer');
            const levelTag = document.getElementById('levelTag');

            displayContainer.classList.remove('pop-in');
            void displayContainer.offsetWidth;
            displayContainer.classList.add('pop-in');

            playTone(523.25, 'triangle', 0.18);
            fruitDisplayArea.innerHTML = '';

            // 1. 單一水果 (僅4種水果)
            if (currentPhaseMode === 'single_4_fruits') {
                const item = BASE_ITEMS[Math.floor(Math.random() * BASE_ITEMS.length)];

                fruitDisplayArea.innerHTML = `<div class="text-9xl md:text-[12rem] bounce-gentle">${item.emoji}</div>`;
                mainTitle.textContent = item.name;
                mainTitle.className = `text-4xl md:text-6xl font-black ${item.color} tracking-wider mt-2`;

                subInstruction.textContent = '👉 請做出對應的肢體動作！';
                subInstruction.className = 'text-2xl md:text-4xl font-black text-rose-600 mt-4 bg-rose-50 border-2 border-rose-200 px-8 py-3 rounded-2xl';

            // 2. 1~4個水果序列 (僅4種水果：蘋果/橘子/西瓜/香蕉，嚴格無葡萄/鳳梨)
            } else if (currentPhaseMode === 'sequence_4_fruits') {
                let count = 1;
                if (questionCount <= 2) count = 1;
                else if (questionCount <= 5) count = 2;
                else if (questionCount <= 9) count = 3;
                else count = 4;

                levelTag.textContent = `難度：${count} 個水果序列 (基礎4項)`;

                const sequence = [];
                const names = [];
                for (let i = 0; i < count; i++) {
                    const item = BASE_ITEMS[Math.floor(Math.random() * BASE_ITEMS.length)];
                    sequence.push(item);
                    names.push(item.name);
                }

                renderFruitSequence(sequence, fruitDisplayArea, count);

                mainTitle.textContent = names.join(' ➔ ');
                mainTitle.className = 'text-2xl md:text-4xl font-black text-purple-800 tracking-wider mt-2 text-center';

                subInstruction.textContent = `👉 請按順序連續做出 ${count} 個動作！`;
                subInstruction.className = 'text-2xl md:text-3xl font-black text-purple-700 mt-4 bg-purple-50 border-2 border-purple-200 px-6 py-3 rounded-2xl';

            // 3. 反向看動作說水果 (使用包含擴充項目之6種水果)
            } else if (currentPhaseMode === 'reverse_action') {
                const item = ALL_SIX_ITEMS[Math.floor(Math.random() * ALL_SIX_ITEMS.length)];

                fruitDisplayArea.innerHTML = `<div class="text-9xl md:text-[12rem] bounce-gentle">${item.actionEmoji}</div>`;
                mainTitle.textContent = item.action;
                mainTitle.className = `text-4xl md:text-6xl font-black ${item.color} tracking-wider mt-2`;

                subInstruction.textContent = '🗣️ 請搶答說出是哪一個水果？';
                subInstruction.className = 'text-2xl md:text-4xl font-black text-indigo-600 mt-4 bg-indigo-50 border-2 border-indigo-200 px-8 py-3 rounded-2xl';

            // 4. 6種水果漸進挑戰 (包含葡萄與鳳梨，且數量由1-2個開始漸進增加)
            } else if (currentPhaseMode === 'six_fruits_gradual') {
                let count = 1;
                if (questionCount <= 2) {
                    count = 1; // 第 1-2 題：單個水果熟悉新動作
                } else if (questionCount <= 5) {
                    count = 2; // 第 3-5 題：2 個水果組合
                } else if (questionCount <= 8) {
                    count = 3; // 第 6-8 題：3 個水果組合
                } else {
                    count = 4; // 第 9 題以上：4 個水果組合挑戰
                }

                levelTag.textContent = `難度：${count} 個水果序列 (包含葡萄鳳梨)`;

                const sequence = [];
                const names = [];
                
                // 前幾題確保提高葡萄與鳳梨出現機率，讓長輩熟練新動作
                for (let i = 0; i < count; i++) {
                    const item = ALL_SIX_ITEMS[Math.floor(Math.random() * ALL_SIX_ITEMS.length)];
                    sequence.push(item);
                    names.push(item.name);
                }

                renderFruitSequence(sequence, fruitDisplayArea, count);

                mainTitle.textContent = names.join(' ➔ ');
                mainTitle.className = 'text-2xl md:text-4xl font-black text-emerald-800 tracking-wider mt-2 text-center';

                subInstruction.textContent = `👉 請按順序連續做出 ${count} 個動作！`;
                subInstruction.className = 'text-2xl md:text-3xl font-black text-emerald-700 mt-4 bg-emerald-50 border-2 border-emerald-200 px-6 py-3 rounded-2xl';
            }
        }

        // 渲染多個水果卡片 UI 輔助函式
        function renderFruitSequence(sequence, container, count) {
            const sizeClass = count > 2 ? 'text-6xl md:text-8xl' : 'text-8xl md:text-9xl';
            sequence.forEach((item, index) => {
                const card = document.createElement('div');
                card.className = 'flex flex-col items-center bg-amber-50 border-4 border-amber-300 rounded-3xl p-3 md:p-5 shadow-sm';
                card.innerHTML = `
                    <span class="text-xs md:text-base font-black bg-amber-400 text-amber-950 px-3 py-1 rounded-full mb-2">第 ${index + 1} 個</span>
                    <span class="${sizeClass} my-1">${item.emoji}</span>
                `;
                container.appendChild(card);
            });
        }

        // 簡報筆/空白鍵/Enter控制下一題
        window.addEventListener('keydown', (e) => {
            if (e.code === 'Space' || e.code === 'Enter') {
                e.preventDefault();
                if (!document.getElementById('gamePlayScreen').classList.contains('hidden')) {
                    nextQuestion();
                } else {
                    startPhase('single_4_fruits');
                }
            }
        });
    </script>
</body>
</html>
